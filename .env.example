# This is a reference template; Pennovia does not auto-load .env files.
# Export variables through your shell or a secret manager. Never commit secrets.
# Optional cloud generation credentials (configure the provider you use).
# Optional default generation backend for CLI and demo
PENNOVIA_BACKEND=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# For local generation, run Ollama and use PENNOVIA_BACKEND=ollama.
# WordPress export is optional, HTTPS-only and draft-by-default.
WP_URL=https://example.org
WP_USER=
WP_APP_PASSWORD=

# Optional Google Drive OAuth credentials
GOOGLE_DRIVE_TOKEN=
