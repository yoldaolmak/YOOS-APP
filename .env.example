# Configure only the backend you intend to use.
YOOS_BACKEND=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama is used only when selected/available.
# Optional WordPress draft export; HTTPS is required.
WP_URL=https://example.org
WP_USER=
WP_APP_PASSWORD=

# Optional Google Drive OAuth authorization JSON
GOOGLE_DRIVE_TOKEN=
